{
  "name": "greenscreen-pos",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply greenscreen-pos --local",
    "db:migrate:remote": "wrangler d1 migrations apply greenscreen-pos --remote",
    "db:seed:local": "wrangler d1 execute greenscreen-pos --local --file=seed.sql"
  },
  "dependencies": {
    "@greenscreen-dev/web": "^0.1.1",
    "@greenscreen-dev/worker": "^0.1.1",
    "hono": "^4.13.14"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.7",
    "@cloudflare/workers-types": "^5.20261025.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.152.0"
  }
}
