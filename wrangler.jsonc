{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "greenscreen-pos",
	"account_id": "d64e67ce2f5262eef1178cd4d08c5380",
	"main": "src/worker.ts",
	"compatibility_date": "2026-10-01",
	"observability": { "enabled": true },
	// The browser terminal, from @greenscreen-dev/web, served at /. Requests
	// that match no file fall through to the Worker.
	"assets": { "directory": "node_modules/@greenscreen-dev/web/public" },
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "greenscreen-pos",
			"database_id": "9ce43736-7fe9-4cfa-8262-032ed6d55b51",
			"migrations_dir": "migrations"
		}
	],
	// Sessions and record locks (one terminal at a time runs a register), in
	// greenscreen's Sessions Durable Object; each register's customer display
	// in a Display (src/display.ts).
	"durable_objects": { "bindings": [{ "name": "SESSIONS", "class_name": "Sessions" }, { "name": "DISPLAYS", "class_name": "Display" }] },
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["Sessions"] }, { "tag": "v2", "new_sqlite_classes": ["Display"] }],
	// Paid sales are posted to the stock ledger through a queue, and a sweep
	// every five minutes posts any the queue missed. The deploy creates the
	// queue if it isn't there.
	"queues": {
		"producers": [{ "binding": "POSTING", "queue": "greenscreen-pos-posting" }],
		"consumers": [{ "queue": "greenscreen-pos-posting", "max_batch_size": 20, "max_batch_timeout": 2, "max_retries": 10 }]
	},
	"triggers": { "crons": ["*/5 * * * *"] },
	// Closing a store's day: post its sales, make its Z report, move it on.
	"workflows": [{ "name": "greenscreen-pos-close-day", "binding": "CLOSE_DAY", "class_name": "CloseDay" }],
	// Cloudflare Access guards the back office; the Worker verifies its JWT.
	// ACCESS_AUD is the audience tag of the Access application for
	// greenscreen-pos.justin-frank.workers.dev (see README).
	// ADMIN_USERS are administrators whether or not they are on the
	// employee file, so the first person can sign on and add the rest.
	// STATE_KEY is a secret: wrangler secret put STATE_KEY.
	"vars": {
		"ACCESS_TEAM_DOMAIN": "parkerfrank.cloudflareaccess.com",
		"ACCESS_AUD": "f47d41426296830268990eeca7be313845262464835ea14ad44d8d815f072b8e",
		"ADMIN_USERS": "JUSTINFR,SDF1JPF"
	}
}
